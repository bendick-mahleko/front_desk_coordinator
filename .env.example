# Copy to .env and fill in. .env is gitignored.

# --- model credentials -------------------------------------------------------
# Either export ANTHROPIC_API_KEY here, or run `ant auth login` and leave this
# blank — the SDK resolves a stored profile automatically. The app checks for
# both and reports which source it found on /health.
ANTHROPIC_API_KEY=

# --- models ------------------------------------------------------------------
AGENT_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Refuse to start if no model credential can be found. Leave false in dev so
# the skeleton still boots and /health can tell you what is missing.
STRICT_CREDENTIALS=false

# --- paths -------------------------------------------------------------------
CLINIC_CONFIG_PATH=clinic.yaml
DATABASE_URL=sqlite:///./data/frontdesk.db

# --- ui ----------------------------------------------------------------------
# Base URL the Streamlit client uses to reach the API.
API_BASE_URL=http://localhost:8000
