# Copy to .env and fill in. .env is gitignored.

# --- model credentials -------------------------------------------------------
# Set exactly one of these, or run `ant auth login` and leave both blank — the
# SDK resolves a stored profile automatically. /health reports which source it
# found and where model calls are routed.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# auto  = use ANTHROPIC_API_KEY if present, else OPENROUTER_API_KEY
# OpenRouter serves an Anthropic-native Messages endpoint, so the SDK, the tool
# runner, strict schemas, adaptive thinking, effort and prompt caching all work
# unchanged. Two differences are handled automatically: model ids are namespaced
# (anthropic/claude-opus-5) and server-side refusal fallbacks are unavailable.
MODEL_PROVIDER=auto

# --- models ------------------------------------------------------------------
# First-party ids. They are translated for OpenRouter automatically.
AGENT_MODEL=claude-opus-5
CLASSIFIER_MODEL=claude-haiku-4-5

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Refuse to start if no model credential can be found. Leave false in dev so
# the skeleton still boots and /health can tell you what is missing.
STRICT_CREDENTIALS=false

# --- paths -------------------------------------------------------------------
CLINIC_CONFIG_PATH=clinic.yaml
DATABASE_URL=sqlite:///./data/frontdesk.db

# --- ui ----------------------------------------------------------------------
# Base URL the Streamlit client uses to reach the API.
API_BASE_URL=http://localhost:8000
