# environment
.env
.venv/
venv/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# runtime data — synthetic, but never commit a database or an audit log.
#
# Anchored to the repository root. As a bare `data/` this also matched
# app/knowledge/data/, so the vendored disease corpus was never committed —
# found while preparing a submission, where a grader would have had every
# knowledge test fail on a missing file.
/data/
*.db
*.sqlite3
audit/
*.jsonl

# office lock files — never committable
.~lock.*#

# editors / os
.idea/
.vscode/
.DS_Store
Thumbs.db
